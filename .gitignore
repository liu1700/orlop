/target/
/.orlop-cache/
/.worktrees/
/.claude/worktrees/
audit.log
*.swp
*.swo
.DS_Store
.env
.env.*
/.claude/artifacts/
/.claude/scheduled_tasks.lock
/.orlop-deploy-secrets/
/bin

dist/


# Go build artifacts (don't commit) — both the in-cmd output path and the
# top-level path produced by `go build ./cmd/...` run from the module root.
cmd/orlop-server/orlop-server
cmd/orlop-control/orlop-control
/orlop-server
/orlop-control
/orlop

# Bench harness output (issue #74). Per-revision JSON / sweep dirs not committed.
bench-results/*
!bench-results/*.md

# Minisign private keys — must never be committed. Keep them outside the
# repo (or at least never tracked).
*.minisign.key
orlop-minisign.key

# Written into the cwd by `orlop mount` (src/agents_md.rs) when running
# against a local mount — not a real production AGENTS.md.
AGENTS.md

# pjdfstest raw results (regenerate via scripts/pjdfstest-docker.sh)
pjdfstest-results/

# Per-arch binaries staged into the container images at release time
# (docker/*.Dockerfile COPY from here); never committed.
docker/bin/*/
